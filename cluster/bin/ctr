#!/usr/bin/env bash
# Executable form of env.sh's `ctr` (run a command inside the container), for callers that can't run
# shell functions, e.g. `timeout -s ABRT 20m cluster/bin/ctr lerobot-train ...`. It execs
# singularity, so a signal sent to this process reaches the containerised command.
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../env.sh"
_ctr_prepare
exec "${_CTR_CMD[@]}" "$@"
