    ketchup_1 - ketchup
    milk_1 - milk
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    ketchup_1
    red_coffee_mug_1
    white_cabinet_1
    white_storage_box_1
  )

  (:init
    (On yellow_book_1 study_table_yellow_book_init_region)
    (On white_cabinet_1 study_table_white_cabinet_init_region)
    (On ketchup_1 study_table_ketchup_init_region)
    (On milk_1 study_table_milk_init_region)
    (On red_coffee_mug_1 study_table_red_coffee_mug_init_region)
    (On wooden_two_layer_shelf_1 study_table_wooden_two_layer_shelf_init_region)
    (On white_storage_box_1 study_table_white_storage_box_init_region)
  )

  (:goal
    (And (On ketchup_1 white_storage_box_1_top_side) (On red_coffee_mug_1 white_cabinet_1_top_side))
  )

)
