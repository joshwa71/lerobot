(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the ketchup on the storage box and put the mug on the cabinet)
    (:regions
      (yellow_book_init_region
          (:target study_table)
          (:ranges (
              (-0.0005 0.1495 0.0295 0.1795)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (white_cabinet_init_region
          (:target study_table)
          (:ranges (
              (-0.1425 -0.4005 -0.1225 -0.3805)
            )
          )
          (:yaw_rotation (
              (3.1416 3.1416)
            )
          )
      )
      (ketchup_init_region
          (:target study_table)
          (:ranges (
              (-0.0365 0.0430 -0.0065 0.0730)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (milk_init_region
          (:target study_table)
          (:ranges (
              (-0.1085 0.1415 -0.0785 0.1715)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (red_coffee_mug_init_region
          (:target study_table)
          (:ranges (
              (0.0550 -0.0150 0.0850 0.0150)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_two_layer_shelf_init_region
