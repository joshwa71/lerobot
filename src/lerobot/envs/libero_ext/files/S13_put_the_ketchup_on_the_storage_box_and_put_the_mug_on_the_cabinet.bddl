          (:ranges (
              (-0.1515 0.0310 -0.1315 0.0510)
            )
          )
          (:yaw_rotation (
              (1.5708 1.5708)
            )
          )
      )
      (top_side
          (:target white_storage_box_1)
      )
      (top_side
          (:target white_cabinet_1)
      )
    )

  (:fixtures
    study_table - study_table
    white_cabinet_1 - white_cabinet
    wooden_two_layer_shelf_1 - wooden_two_layer_shelf
    white_storage_box_1 - white_storage_box
