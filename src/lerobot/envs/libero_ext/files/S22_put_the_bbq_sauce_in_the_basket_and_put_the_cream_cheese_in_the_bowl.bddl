(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the bbq sauce in the basket and put the cream cheese in the bowl)
    (:regions
      (basket_init_region
          (:target main_table)
          (:ranges (
              (-0.0165 0.0600 0.0135 0.0900)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (bbq_sauce_init_region
          (:target main_table)
          (:ranges (
              (-0.1005 -0.1815 -0.0705 -0.1515)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (akita_black_bowl_init_region
          (:target main_table)
          (:ranges (
              (-0.0815 0.2485 -0.0515 0.2785)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (butter_init_region
          (:target main_table)
          (:ranges (
              (-0.2970 -0.3050 -0.2670 -0.2750)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (cream_cheese_init_region
          (:target main_table)
          (:ranges (
              (-0.1345 -0.2435 -0.1045 -0.2135)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (chefmate_8_frypan_init_region
          (:target main_table)
          (:ranges (
              (-0.2750 -0.0250 -0.2450 0.0050)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    basket_1 - basket
    bbq_sauce_1 - bbq_sauce
    akita_black_bowl_1 - akita_black_bowl
    butter_1 - butter
    cream_cheese_1 - cream_cheese
    chefmate_8_frypan_1 - chefmate_8_frypan
  )

  (:obj_of_interest
    akita_black_bowl_1
    basket_1
    bbq_sauce_1
    cream_cheese_1
  )

  (:init
    (On basket_1 main_table_basket_init_region)
    (On bbq_sauce_1 main_table_bbq_sauce_init_region)
    (On akita_black_bowl_1 main_table_akita_black_bowl_init_region)
    (On butter_1 main_table_butter_init_region)
    (On cream_cheese_1 main_table_cream_cheese_init_region)
    (On chefmate_8_frypan_1 main_table_chefmate_8_frypan_init_region)
  )

  (:goal
    (And (In bbq_sauce_1 basket_1_contain_region) (On cream_cheese_1 akita_black_bowl_1))
  )

)
