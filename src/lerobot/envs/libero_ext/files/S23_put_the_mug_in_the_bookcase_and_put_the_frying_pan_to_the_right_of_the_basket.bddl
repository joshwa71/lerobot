(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the mug in the bookcase and put the frying pan to the right of the basket)
    (:regions
      (basket_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1165 0.0200 -0.0865 0.0500)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_shelf_init_region
          (:target living_room_table)
          (:ranges (
              (0.0780 -0.3855 0.0980 -0.3655)
            )
          )
          (:yaw_rotation (
              (3.1416 3.1416)
            )
          )
      )
      (chefmate_8_frypan_init_region
          (:target living_room_table)
          (:ranges (
              (0.0850 0.1950 0.1150 0.2250)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (porcelain_mug_init_region
          (:target living_room_table)
          (:ranges (
              (-0.0650 -0.1550 -0.0350 -0.1250)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (popcorn_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1440 -0.3440 -0.1140 -0.3140)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (middle_region
          (:target wooden_shelf_1)
      )
      (basket_right_region
          (:target living_room_table)
          (:ranges (
              (-0.1515 0.2680 -0.0515 0.3680)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
    wooden_shelf_1 - wooden_shelf
  )

  (:objects
    basket_1 - basket
    chefmate_8_frypan_1 - chefmate_8_frypan
    porcelain_mug_1 - porcelain_mug
    popcorn_1 - popcorn
  )

  (:obj_of_interest
    chefmate_8_frypan_1
    porcelain_mug_1
    wooden_shelf_1
  )

  (:init
    (On basket_1 living_room_table_basket_init_region)
    (On wooden_shelf_1 living_room_table_wooden_shelf_init_region)
    (On chefmate_8_frypan_1 living_room_table_chefmate_8_frypan_init_region)
    (On porcelain_mug_1 living_room_table_porcelain_mug_init_region)
    (On popcorn_1 living_room_table_popcorn_init_region)
  )

  (:goal
    (And (In porcelain_mug_1 wooden_shelf_1_middle_region) (On chefmate_8_frypan_1 living_room_table_basket_right_region))
  )

)
