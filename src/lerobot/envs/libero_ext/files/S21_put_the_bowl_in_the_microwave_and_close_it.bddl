(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the bowl in the microwave and close it)
    (:regions
      (alphabet_soup_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1635 0.1465 -0.1335 0.1765)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (white_bowl_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0615 0.1685 -0.0315 0.1985)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (butter_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0170 -0.1650 0.0130 -0.1350)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (white_cabinet_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1425 0.3805 -0.1225 0.4005)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (microwave_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2575 -0.4215 -0.2375 -0.4015)
            )
          )
          (:yaw_rotation (
              (3.1416 3.1416)
            )
          )
      )
      (heating_region
          (:target microwave_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    white_cabinet_1 - white_cabinet
    microwave_1 - microwave
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    white_bowl_1 - white_bowl
    butter_1 - butter
  )

  (:obj_of_interest
    microwave_1
    white_bowl_1
  )

  (:init
    (On alphabet_soup_1 kitchen_table_alphabet_soup_init_region)
    (On white_bowl_1 kitchen_table_white_bowl_init_region)
    (On butter_1 kitchen_table_butter_init_region)
    (On white_cabinet_1 kitchen_table_white_cabinet_init_region)
    (On microwave_1 kitchen_table_microwave_init_region)
    (Open microwave_1)
  )

  (:goal
    (And (In white_bowl_1 microwave_1_heating_region) (Close microwave_1))
  )

)
