(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the book in the bookcase)
    (:regions
      (alphabet_soup_init_region
          (:target main_table)
          (:ranges (
              (-0.0235 -0.2135 0.0065 -0.1835)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (basket_init_region
          (:target main_table)
          (:ranges (
              (-0.0765 0.1000 -0.0465 0.1300)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (bbq_sauce_init_region
          (:target main_table)
          (:ranges (
              (-0.3205 -0.0215 -0.2905 0.0085)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (yellow_book_init_region
          (:target main_table)
          (:ranges (
              (-0.1605 -0.1305 -0.1305 -0.1005)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_shelf_init_region
          (:target main_table)
          (:ranges (
              (-0.2020 0.3655 -0.1820 0.3855)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_two_layer_shelf_init_region
          (:target main_table)
          (:ranges (
              (-0.1140 -0.3855 -0.0940 -0.3655)
            )
          )
          (:yaw_rotation (
              (3.1416 3.1416)
            )
          )
      )
      (wine_bottle_init_region
          (:target main_table)
          (:ranges (
              (0.0270 -0.0630 0.0570 -0.0330)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (middle_region
          (:target wooden_shelf_1)
      )
    )

  (:fixtures
    main_table - table
    wooden_shelf_1 - wooden_shelf
    wooden_two_layer_shelf_1 - wooden_two_layer_shelf
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    basket_1 - basket
    bbq_sauce_1 - bbq_sauce
    yellow_book_1 - yellow_book
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    wooden_shelf_1
    yellow_book_1
  )

  (:init
    (On alphabet_soup_1 main_table_alphabet_soup_init_region)
    (On basket_1 main_table_basket_init_region)
    (On bbq_sauce_1 main_table_bbq_sauce_init_region)
    (On yellow_book_1 main_table_yellow_book_init_region)
    (On wooden_shelf_1 main_table_wooden_shelf_init_region)
    (On wooden_two_layer_shelf_1 main_table_wooden_two_layer_shelf_init_region)
    (On wine_bottle_1 main_table_wine_bottle_init_region)
  )

  (:goal
    (And (In yellow_book_1 wooden_shelf_1_middle_region))
  )

)
