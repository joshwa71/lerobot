(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the popcorn in the microwave and put the mug in the tray)
    (:regions
      (cookies_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.3135 0.0260 -0.2835 0.0560)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (short_fridge_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.3290 -0.4065 -0.3090 -0.3865)
            )
          )
          (:yaw_rotation (
              (3.1416 3.1416)
            )
          )
      )
      (ketchup_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2165 0.0230 -0.1865 0.0530)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (microwave_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0775 0.4015 -0.0575 0.4215)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (white_yellow_mug_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0050 -0.2950 0.0250 -0.2650)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (plate_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1460 -0.2360 -0.1160 -0.2060)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (popcorn_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.3040 0.1560 -0.2740 0.1860)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_tray_init_region
          (:target kitchen_table)
          (:ranges (
              (0.0050 -0.0615 0.0350 -0.0315)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (heating_region
          (:target microwave_1)
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    short_fridge_1 - short_fridge
    microwave_1 - microwave
  )

  (:objects
    cookies_1 - cookies
    ketchup_1 - ketchup
    white_yellow_mug_1 - white_yellow_mug
    plate_1 - plate
    popcorn_1 - popcorn
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    microwave_1
    popcorn_1
    white_yellow_mug_1
    wooden_tray_1
  )

  (:init
    (On cookies_1 kitchen_table_cookies_init_region)
    (On short_fridge_1 kitchen_table_short_fridge_init_region)
    (On ketchup_1 kitchen_table_ketchup_init_region)
    (On microwave_1 kitchen_table_microwave_init_region)
    (On white_yellow_mug_1 kitchen_table_white_yellow_mug_init_region)
    (On plate_1 kitchen_table_plate_init_region)
    (On popcorn_1 kitchen_table_popcorn_init_region)
    (On wooden_tray_1 kitchen_table_wooden_tray_init_region)
    (Open microwave_1)
  )

  (:goal
    (And (In popcorn_1 microwave_1_heating_region) (In white_yellow_mug_1 wooden_tray_1_contain_region))
  )

)
