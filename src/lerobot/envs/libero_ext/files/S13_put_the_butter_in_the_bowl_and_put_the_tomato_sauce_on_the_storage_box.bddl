          (:ranges (
              (-0.0990 -0.0615 -0.0790 -0.0415)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (tomato_sauce_init_region
          (:target study_table)
          (:ranges (
              (-0.2435 -0.0740 -0.2135 -0.0440)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (top_side
          (:target white_storage_box_1)
      )
    )

  (:fixtures
    study_table - study_table
    white_storage_box_1 - white_storage_box
  )

  (:objects
    yellow_book_1 - yellow_book
    white_bowl_1 - white_bowl
    butter_1 - butter
    plate_1 - plate
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    butter_1
    tomato_sauce_1
    white_bowl_1
    white_storage_box_1
  )

  (:init
    (On yellow_book_1 study_table_yellow_book_init_region)
    (On white_bowl_1 study_table_white_bowl_init_region)
    (On butter_1 study_table_butter_init_region)
    (On plate_1 study_table_plate_init_region)
    (On glazed_rim_porcelain_ramekin_1 study_table_glazed_rim_porcelain_ramekin_init_region)
    (On white_storage_box_1 study_table_white_storage_box_init_region)
    (On tomato_sauce_1 study_table_tomato_sauce_init_region)
  )

  (:goal
    (And (On butter_1 white_bowl_1) (On tomato_sauce_1 white_storage_box_1_top_side))
  )

)
