              (-0.0605 -0.2505 -0.0305 -0.2205)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (white_bowl_init_region
          (:target study_table)
          (:ranges (
              (-0.1415 0.1485 -0.1115 0.1785)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (butter_init_region
          (:target study_table)
          (:ranges (
              (-0.2570 0.2950 -0.2270 0.3250)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (plate_init_region
          (:target study_table)
          (:ranges (
              (0.0340 0.0840 0.0640 0.1140)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_init_region
          (:target study_table)
          (:ranges (
              (0.0095 0.2795 0.0395 0.3095)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (white_storage_box_init_region
