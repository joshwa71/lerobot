(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the popcorn in the bookcase)
    (:regions
      (wooden_shelf_init_region
          (:target study_table)
          (:ranges (
              (-0.0420 0.3655 -0.0220 0.3855)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (akita_black_bowl_init_region
          (:target study_table)
          (:ranges (
              (-0.0615 -0.1715 -0.0315 -0.1415)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (cream_cheese_init_region
          (:target study_table)
          (:ranges (
              (-0.0745 0.1365 -0.0445 0.1665)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (popcorn_init_region
          (:target study_table)
          (:ranges (
              (-0.0640 0.0160 -0.0340 0.0460)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (middle_region
          (:target wooden_shelf_1)
      )
    )

  (:fixtures
    study_table - study_table
    wooden_shelf_1 - wooden_shelf
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cream_cheese_1 - cream_cheese
    popcorn_1 - popcorn
  )

  (:obj_of_interest
    popcorn_1
    wooden_shelf_1
  )

  (:init
    (On wooden_shelf_1 study_table_wooden_shelf_init_region)
    (On akita_black_bowl_1 study_table_akita_black_bowl_init_region)
    (On cream_cheese_1 study_table_cream_cheese_init_region)
    (On popcorn_1 study_table_popcorn_init_region)
  )

  (:goal
    (And (In popcorn_1 wooden_shelf_1_middle_region))
  )

)
