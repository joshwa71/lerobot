    (On new_salad_dressing_1 kitchen_table_new_salad_dressing_init_region)
    (Open short_fridge_1)
  )

  (:goal
    (And (In new_salad_dressing_1 short_fridge_1_middle_region) (On bbq_sauce_1 kitchen_table_white_bowl_front_region))
