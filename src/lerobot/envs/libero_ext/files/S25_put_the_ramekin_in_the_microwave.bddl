(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the ramekin in the microwave)
    (:regions
      (butter_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2770 0.0150 -0.2470 0.0450)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (microwave_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0975 0.4015 -0.0775 0.4215)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2905 -0.2405 -0.2605 -0.2105)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (flat_stove_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0100 -0.1850 0.0100 -0.1650)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
      (heating_region
          (:target microwave_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    microwave_1 - microwave
    flat_stove_1 - flat_stove
  )

  (:objects
    butter_1 - butter
    chefmate_8_frypan_1 - chefmate_8_frypan
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
  )

  (:obj_of_interest
    glazed_rim_porcelain_ramekin_1
    microwave_1
  )

  (:init
    (On butter_1 kitchen_table_butter_init_region)
    (On chefmate_8_frypan_1 flat_stove_1_cook_region)
    (On microwave_1 kitchen_table_microwave_init_region)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_glazed_rim_porcelain_ramekin_init_region)
    (On flat_stove_1 kitchen_table_flat_stove_init_region)
    (Open microwave_1)
  )

  (:goal
    (And (In glazed_rim_porcelain_ramekin_1 microwave_1_heating_region))
  )

)
