(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the tomato sauce in the bottom drawer and put the orange juice in the tray)
    (:regions
      (white_cabinet_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.3225 -0.4005 -0.3025 -0.3805)
            )
          )
          (:yaw_rotation (
              (3.1416 3.1416)
            )
          )
      )
      (orange_juice_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1485 -0.1585 -0.1185 -0.1285)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (tomato_sauce_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.3235 0.1460 -0.2935 0.1760)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_tray_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0950 0.1185 -0.0650 0.1485)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (bottom_region
          (:target white_cabinet_1)
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    white_cabinet_1 - white_cabinet
  )

  (:objects
    orange_juice_1 - orange_juice
    tomato_sauce_1 - tomato_sauce
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    orange_juice_1
    tomato_sauce_1
    white_cabinet_1
    wooden_tray_1
  )

  (:init
    (On white_cabinet_1 kitchen_table_white_cabinet_init_region)
    (On orange_juice_1 kitchen_table_orange_juice_init_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_init_region)
    (On wooden_tray_1 kitchen_table_wooden_tray_init_region)
    (Open white_cabinet_1_bottom_region)
  )

  (:goal
    (And (In tomato_sauce_1 white_cabinet_1_bottom_region) (In orange_juice_1 wooden_tray_1_contain_region))
  )

)
