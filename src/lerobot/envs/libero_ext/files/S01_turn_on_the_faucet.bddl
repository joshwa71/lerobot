(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language turn on the faucet)
    (:regions
      (butter_init_region
          (:target kitchen_table)
          (:ranges (
              (0.0230 -0.2650 0.0530 -0.2350)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (cookies_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2735 -0.0340 -0.2435 -0.0040)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (faucet_init_region
          (:target kitchen_table)
          (:ranges (
              (0.0100 0.0260 0.0300 0.0460)
            )
          )
          (:yaw_rotation (
              (1.5708 1.5708)
            )
          )
      )
      (short_fridge_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2690 0.3865 -0.2490 0.4065)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_tray_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0150 -0.1415 0.0150 -0.1115)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    faucet_1 - faucet
    short_fridge_1 - short_fridge
  )

  (:objects
    butter_1 - butter
    cookies_1 - cookies
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    faucet_1
  )

  (:init
    (On butter_1 kitchen_table_butter_init_region)
    (On cookies_1 kitchen_table_cookies_init_region)
    (On faucet_1 kitchen_table_faucet_init_region)
    (On short_fridge_1 kitchen_table_short_fridge_init_region)
    (On wooden_tray_1 kitchen_table_wooden_tray_init_region)
    (Turnoff faucet_1)
  )

  (:goal
    (And (Turnon faucet_1))
  )

)
