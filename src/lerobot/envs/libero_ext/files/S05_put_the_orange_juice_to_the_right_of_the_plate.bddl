(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the orange juice to the right of the plate)
    (:regions
      (chocolate_pudding_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2750 0.0980 -0.2450 0.1280)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (short_fridge_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0690 0.3865 -0.0490 0.4065)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (orange_juice_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.3085 0.2615 -0.2785 0.2915)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (plate_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0260 -0.1760 0.0040 -0.1460)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (tomato_sauce_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2435 -0.3140 -0.2135 -0.2840)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (plate_right_region
          (:target kitchen_table)
          (:ranges (
              (-0.0610 -0.0720 0.0390 0.0280)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    short_fridge_1 - short_fridge
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    orange_juice_1 - orange_juice
    plate_1 - plate
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    orange_juice_1
  )

  (:init
    (On chocolate_pudding_1 kitchen_table_chocolate_pudding_init_region)
    (On short_fridge_1 kitchen_table_short_fridge_init_region)
    (On orange_juice_1 kitchen_table_orange_juice_init_region)
    (On plate_1 kitchen_table_plate_init_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_init_region)
  )

  (:goal
    (And (On orange_juice_1 kitchen_table_plate_right_region))
  )

)
