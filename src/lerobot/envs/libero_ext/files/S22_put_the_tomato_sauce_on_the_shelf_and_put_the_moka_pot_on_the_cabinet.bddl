(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the tomato sauce on the shelf and put the moka pot on the cabinet)
    (:regions
      (alphabet_soup_init_region
          (:target main_table)
          (:ranges (
              (-0.0835 0.0465 -0.0535 0.0765)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_cabinet_init_region
          (:target main_table)
          (:ranges (
              (-0.2225 -0.4005 -0.2025 -0.3805)
            )
          )
          (:yaw_rotation (
              (3.1416 3.1416)
            )
          )
      )
      (moka_pot_init_region
          (:target main_table)
          (:ranges (
              (-0.0145 -0.2310 0.0155 -0.2010)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_two_layer_shelf_init_region
          (:target main_table)
          (:ranges (
              (-0.0940 0.3655 -0.0740 0.3855)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (tomato_sauce_init_region
          (:target main_table)
          (:ranges (
              (-0.2035 -0.0540 -0.1735 -0.0240)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (top_side
          (:target wooden_two_layer_shelf_1)
      )
      (top_side
          (:target wooden_cabinet_1)
      )
    )

  (:fixtures
    main_table - table
    wooden_cabinet_1 - wooden_cabinet
    wooden_two_layer_shelf_1 - wooden_two_layer_shelf
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    moka_pot_1 - moka_pot
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    moka_pot_1
    tomato_sauce_1
    wooden_cabinet_1
    wooden_two_layer_shelf_1
  )

  (:init
    (On alphabet_soup_1 main_table_alphabet_soup_init_region)
    (On wooden_cabinet_1 main_table_wooden_cabinet_init_region)
    (On moka_pot_1 main_table_moka_pot_init_region)
    (On wooden_two_layer_shelf_1 main_table_wooden_two_layer_shelf_init_region)
    (On tomato_sauce_1 main_table_tomato_sauce_init_region)
  )

  (:goal
    (And (On tomato_sauce_1 wooden_two_layer_shelf_1_top_side) (On moka_pot_1 wooden_cabinet_1_top_side))
  )

)
