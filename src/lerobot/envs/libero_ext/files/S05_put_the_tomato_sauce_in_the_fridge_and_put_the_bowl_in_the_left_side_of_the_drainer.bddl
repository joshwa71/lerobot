(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the tomato sauce in the fridge and put the bowl in the left side of the drainer)
    (:regions
      (akita_black_bowl_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2215 0.0685 -0.1915 0.0985)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (bowl_drainer_init_region
          (:target kitchen_table)
          (:ranges (
              (0.0100 0.0800 0.0300 0.1000)
            )
          )
          (:yaw_rotation (
              (1.5708 1.5708)
            )
          )
      )
      (short_fridge_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2090 -0.4065 -0.1890 -0.3865)
            )
          )
          (:yaw_rotation (
              (3.1416 3.1416)
            )
          )
      )
      (popcorn_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0640 -0.1840 -0.0340 -0.1540)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (tomato_sauce_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.3035 0.2060 -0.2735 0.2360)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (middle_region
          (:target short_fridge_1)
      )
      (left_region
          (:target bowl_drainer_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    bowl_drainer_1 - bowl_drainer
    short_fridge_1 - short_fridge
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    popcorn_1 - popcorn
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    akita_black_bowl_1
    bowl_drainer_1
    short_fridge_1
    tomato_sauce_1
  )

  (:init
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_init_region)
    (On bowl_drainer_1 kitchen_table_bowl_drainer_init_region)
    (On short_fridge_1 kitchen_table_short_fridge_init_region)
    (On popcorn_1 kitchen_table_popcorn_init_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_init_region)
    (Open short_fridge_1)
  )

  (:goal
    (And (In tomato_sauce_1 short_fridge_1_middle_region) (In akita_black_bowl_1 bowl_drainer_1_left_region))
  )

)
