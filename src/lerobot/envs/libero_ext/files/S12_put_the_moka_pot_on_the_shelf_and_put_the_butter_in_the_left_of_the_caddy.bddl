(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the moka pot on the shelf and put the butter in the left of the caddy)
    (:regions
      (alphabet_soup_init_region
          (:target study_table)
          (:ranges (
              (0.0965 -0.0735 0.1265 -0.0435)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (butter_init_region
          (:target study_table)
          (:ranges (
              (-0.0170 -0.1050 0.0130 -0.0750)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_cabinet_init_region
          (:target study_table)
          (:ranges (
              (-0.2625 0.3805 -0.2425 0.4005)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (desk_caddy_init_region
          (:target study_table)
          (:ranges (
              (-0.0145 0.2400 0.0055 0.2600)
            )
          )
          (:yaw_rotation (
              (3.1416 3.1416)
            )
          )
      )
      (moka_pot_init_region
          (:target study_table)
          (:ranges (
              (-0.1945 -0.0310 -0.1645 -0.0010)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_two_layer_shelf_init_region
