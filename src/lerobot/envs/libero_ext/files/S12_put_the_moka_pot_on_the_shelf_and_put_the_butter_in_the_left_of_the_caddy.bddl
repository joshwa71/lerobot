      )
      (top_side
          (:target wooden_two_layer_shelf_1)
      )
      (left_contain_region
          (:target desk_caddy_1)
      )
    )

  (:fixtures
    study_table - study_table
    wooden_cabinet_1 - wooden_cabinet
    desk_caddy_1 - desk_caddy
    wooden_two_layer_shelf_1 - wooden_two_layer_shelf
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    butter_1 - butter
    moka_pot_1 - moka_pot
  )

  (:obj_of_interest
    butter_1
    desk_caddy_1
    moka_pot_1
    wooden_two_layer_shelf_1
  )

  (:init
    (On alphabet_soup_1 study_table_alphabet_soup_init_region)
    (On butter_1 study_table_butter_init_region)
    (On wooden_cabinet_1 study_table_wooden_cabinet_init_region)
    (On desk_caddy_1 study_table_desk_caddy_init_region)
    (On moka_pot_1 study_table_moka_pot_init_region)
    (On wooden_two_layer_shelf_1 study_table_wooden_two_layer_shelf_init_region)
  )

  (:goal
    (And (On moka_pot_1 wooden_two_layer_shelf_1_top_side) (In butter_1 desk_caddy_1_left_contain_region))
  )

)
