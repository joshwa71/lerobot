            )
          )
      )
      (microwave_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2175 0.4015 -0.1975 0.4215)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (dining_set_group_init_region
          (:target kitchen_table)
          (:ranges (
