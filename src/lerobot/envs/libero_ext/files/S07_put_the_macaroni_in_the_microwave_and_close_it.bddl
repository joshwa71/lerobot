  (:fixtures
    kitchen_table - kitchen_table
    wooden_cabinet_1 - wooden_cabinet
    microwave_1 - microwave
    dining_set_group_1 - dining_set_group
  )

  (:objects
    macaroni_and_cheese_1 - macaroni_and_cheese
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    salad_dressing_1 - salad_dressing
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    macaroni_and_cheese_1
    microwave_1
  )

  (:init
    (On wooden_cabinet_1 kitchen_table_wooden_cabinet_init_region)
    (On macaroni_and_cheese_1 kitchen_table_macaroni_and_cheese_init_region)
    (On microwave_1 kitchen_table_microwave_init_region)
    (On dining_set_group_1 kitchen_table_dining_set_group_init_region)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_glazed_rim_porcelain_ramekin_init_region)
    (On salad_dressing_1 kitchen_table_salad_dressing_init_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_init_region)
    (Open microwave_1)
  )

  (:goal
    (And (In macaroni_and_cheese_1 microwave_1_heating_region) (Close microwave_1))
  )

)
